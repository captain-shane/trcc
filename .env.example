# TR Command Center — docker compose configuration.
# Copy to .env and adjust. All values optional; defaults shown.

# Host port to publish the app on
TRR_PORT=3000

# Local model server (the ONLY external endpoint the app talks to).
# Works with Ollama, LM Studio, llama.cpp, vLLM, or any OpenAI-compatible
# server — the protocol is auto-detected.
# - Ollama on the Docker host:      http://host.docker.internal:11434
# - LM Studio on the Docker host:   http://host.docker.internal:1234
# - A server on another LAN box:    http://10.0.0.42:11434
AI_URL=http://host.docker.internal:11434

# Models (must exist on your server — `ollama list` / LM Studio's model list)
AI_MODEL=gemma4-16k:latest
AI_DIGEST_MODEL=gemma4:26b
AI_EMBED_MODEL=nomic-embed-text

# No local model server? The app runs fine without one — untick
# "Enable AI features" in Settings (GUI) for full AI-free mode.
